{
  "$name": "Lorewords Design Tokens",
  "$version": "1.0.0",
  "concept": "Seis Tintas — cada cor de tinta do TCG vira um papel funcional no app.",
  "ink": {
    "amber":    { "dark": "#F2A93B", "light": "#9A6200", "papel": "Aprendendo / destaque / acento da marca" },
    "ruby":     { "dark": "#FF6478", "light": "#C22B45", "papel": "Errei / difícil / alerta" },
    "amethyst": { "dark": "#A47BFF", "light": "#6B37D0", "papel": "Modo avançado / conteúdo mágico" },
    "sapphire": { "dark": "#5B9CFF", "light": "#1F56C7", "papel": "Cor primária da marca / novo / links" },
    "emerald":  { "dark": "#3DD8A0", "light": "#0A7551", "papel": "Acertei / dominado / sucesso" },
    "steel":    { "dark": "#9BB0CC", "light": "#47576F", "papel": "Neutro / metadados / estrutura" }
  },
  "surface": {
    "bg":        { "dark": "#0A0D14", "light": "#FBFAF7" },
    "surface":   { "dark": "#121724", "light": "#FFFFFF" },
    "surface-2": { "dark": "#1A2130", "light": "#F4F2EC" },
    "surface-3": { "dark": "#232C3E", "light": "#E9E6DE" },
    "line":        { "dark": "#262F42", "light": "#E2DFD6" },
    "line-strong": { "dark": "#3A465D", "light": "#C9C4B7" }
  },
  "text": {
    "text":       { "dark": "#E9EEF9", "light": "#101623", "contraste": "16.7 / 17.3" },
    "text-muted": { "dark": "#9AA7BE", "light": "#525E73", "contraste": "8.0 / 6.3" },
    "text-faint": { "dark": "#6B7890", "light": "#646F82", "contraste": "4.4 / 4.9" }
  },
  "estados": {
    "novo": "sapphire", "aprendendo": "amber", "dominado": "emerald", "dificil": "ruby", "avancado": "amethyst"
  },
  "tipografia": {
    "display": "Lora (600/700) — títulos, wordmark, palavra-alvo",
    "ui": "Inter (400/500/600) — interface, textos, botões",
    "mono": "JetBrains Mono (400) — fonética/IPA, códigos de carta"
  },
  "raio": { "sm": 8, "md": 12, "lg": 18, "xl": 26, "full": 999 },
  "espaco": [4, 8, 12, 16, 24, 32, 48, 64]
}
